---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import ThreeScene from "../../components/ThreeScene.astro";

import { Image } from "astro:assets";

import { getMergedBirdData } from "../../utils/birdDataMerger";
// import { getCurrentMonthAndTime } from "../../utils/timeUtils";

// This function tells Astro that the collection should be built statically
// Something like...
// export const prerender = false;
// Won't work because of this function
export function getStaticPaths() {
  const mergedBirdData = getMergedBirdData();
  return Object.entries(mergedBirdData)
    .filter(([_, bird]) => bird && bird.name) // Ensure we have valid bird data
    .map(([slug]) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const mergedBirdData = getMergedBirdData();
const bird = mergedBirdData[slug];
// console.log({ bird });

// Handle case where bird doesn't exist
if (!bird) {
  return Astro.redirect("/404"); // TODO build 404 page
}
---

<Layout title={bird.name}>
  <main>
    <!-- <aside>
      <Card
        href={slug}
        title=`Hello from [slug].astro`
        body=`This is my bird slug page, currently showing ${slug}`
      />
    </aside> -->

    <ThreeScene
      imageSlug=`${bird.slug}.jpg`
      cameraPosition={{ x: 0, y: -100, z: 100 }}
    />

    <header>
      <h1>{bird.name}</h1>
      <p><small>{bird.latin}</small></p>
      <p>{bird.description}</p>
    </header>

    {
      bird.images && bird.images.length > 0 && (
        <section>
          <h2>What I look like</h2>
          {bird.images.map((image) => (
            <figure>
              <Image
                src={image.url}
                alt={image.caption}
                width="200"
                height="140"
              />
              <figcaption>
                Uploaded by <em>{image.author}</em> on{" "}
                <a href={image.source.url}>{image.source.title}</a>.
                <br />
                {image.caption}
              </figcaption>
            </figure>
          ))}
        </section>
      )
    }

    {
      bird.sounds && bird.sounds.length > 0 && (
        <section>
          <h2>How I sound</h2>
          {bird.sounds.map((sound) => (
            <figure>
              <audio controls src={`/sounds/${sound.file}.mp3`} />
              When I {sound.description}
              <figcaption>
                Uploaded by <em>{sound.author}</em> on{" "}
                <a href={sound.source.url}>{sound.source.title}</a>.
                <br />
                <a href={sound.license.url}>{sound.license.type}</a>
              </figcaption>
            </figure>
          ))}
        </section>
      )
    }

    {
      bird.facts && bird.facts.length > 0 && (
        <section>
          <h2>Fun facts about me</h2>
          <ul>
            {bird.facts.map((fact) => (
              <li>
                <h3>{fact.title}</h3>
                <p>{fact.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Layout>
<style>
  main {
    margin: auto;
    padding: 1rem;
    width: 800px;
    max-width: calc(100% - 2rem);
    color: white;
    font-size: 20px;
    line-height: 1.6;
  }

  header {
    text-align: center;
  }
</style>
